{
  "name": "SupportTicket",
  "type": "object",
  "properties": {
    "customer_email": {
      "type": "string"
    },
    "customer_name": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "waiting",
        "responded",
        "closed"
      ],
      "default": "open"
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Array of {sender, content, timestamp}"
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "customer_email"
  ]
}