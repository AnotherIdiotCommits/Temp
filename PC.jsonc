{
  "name": "PC",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "PC model name e.g. ZTB-1"
    },
    "display_name": {
      "type": "string",
      "description": "Display name for the PC"
    },
    "slug": {
      "type": "string",
      "description": "URL slug"
    },
    "base_price": {
      "type": "number",
      "description": "Base price in USD"
    },
    "sale_price": {
      "type": "number",
      "description": "Sale price if on sale"
    },
    "on_sale": {
      "type": "boolean",
      "default": false
    },
    "sold_out": {
      "type": "boolean",
      "default": false
    },
    "is_weekly": {
      "type": "boolean",
      "default": false,
      "description": "True if this is a weekly drop PC"
    },
    "weekly_status": {
      "type": "string",
      "enum": [
        "next_week",
        "current",
        "previous"
      ],
      "description": "Status of the weekly PC in the rotation"
    },
    "color_theme": {
      "type": "string",
      "enum": [
        "black",
        "white"
      ],
      "default": "black"
    },
    "platform": {
      "type": "string",
      "enum": [
        "AM4",
        "AM5"
      ]
    },
    "ram_type": {
      "type": "string",
      "enum": [
        "DDR4",
        "DDR5"
      ]
    },
    "case_size": {
      "type": "string",
      "enum": [
        "mATX_Case",
        "ATX_Case"
      ]
    },
    "image_url": {
      "type": "string"
    },
    "gallery_urls": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "base_cpu": {
      "type": "string"
    },
    "base_gpu": {
      "type": "string"
    },
    "base_ram": {
      "type": "string"
    },
    "base_storage": {
      "type": "string"
    },
    "base_cooler": {
      "type": "string"
    },
    "base_psu": {
      "type": "string"
    },
    "base_motherboard": {
      "type": "string"
    },
    "base_cables": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "visible": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "name",
    "base_price"
  ]
}